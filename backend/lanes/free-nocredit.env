# Totally free profile — no credit, no card: only a free Gemini key and a free Groq key (keys from .env).
#   npx tsx --env-file=.env --env-file=lanes/free-nocredit.env src/index.ts
# Plan + spec check on the Gemini Flash pool (~20 req/day each, ~100/day together; frequent 503s → pool),
# Flash-Lite as last resort. Execute on Flash-Lite. Review on Groq gpt-oss-120b (replay 1/9 false
# approvals; compact rendering fits its 8K cap), Flash pool as fallback. See docs/architecture/free-without-credit.md.
PW_LANES_PLAN=gemini:gemini-3.6-flash,gemini:gemini-3-flash-preview,gemini:gemini-3.8-flash,gemini:gemini-3.5-flash,gemini:gemini-3.7-flash,gemini:gemini-3.5-flash-lite
PW_LANES_RUN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,groq:qwen/qwen3.8-27b
PW_LANES_JUDGE=groq:openai/gpt-oss-120b,gemini:gemini-3.6-flash,gemini:gemini-3-flash-preview,gemini:gemini-3.8-flash
PW_LANES_VISION=groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash-lite
PW_RUN_STEP_FACTOR=1.5
