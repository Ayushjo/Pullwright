# Free-tier lane profile (no secrets — keys come from .env). Layer it on top:
#   npx tsx --env-file=.env --env-file=lanes/free.env src/index.ts
# Plan on the Vercel free credit (gpt-5-mini, the proven planner); execute on Gemini Flash-Lite with
# Groq qwen as a small-prompt fallback (Groq free rejects requests over 8K tokens).
# Review: gpt-5-mini on the credit first (replay: 2/11 false approvals), Groq gpt-oss-120b as fallback
# (1/9, compact rendering for its 8K cap, ~35-40 reviews/day). Flash-Lite is never the reviewer: it
# approved 8 of 11 bad patches (docs/architecture/qualification.md §1).
PW_LANES_PLAN=vercel:openai/gpt-5-mini,gemini:gemini-3.5-flash
PW_LANES_RUN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,groq:qwen/qwen3.8-27b
PW_LANES_JUDGE=vercel:openai/gpt-5-mini,groq:openai/gpt-oss-120b
# Flash-Lite needs ~1.3-1.5x the turns of gpt-5-mini on large items; its calls cost only free quota.
PW_RUN_STEP_FACTOR=1.5
