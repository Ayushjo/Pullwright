# Shared with the API (Railway): use the *public* Redis URL from Railway → Redis → Connect.
REDIS_URL=redis://default:<password>@<host>.proxy.rlwy.net:<port>
DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
SESSION_SECRET=<same value as the API — decrypts task GitHub tokens>

# Operator key (used only when a user hasn't added their own key)
OPENAI_API_KEY=sk-...
SPEND_HARD_STOP_USD=5
TASK_BUDGET_USD=0.15
PW_PLAN_MODEL=gpt-5-mini
PW_RUN_MODEL=gpt-5-mini
PW_JUDGE_MODEL=gpt-5-mini

# Paths / sandbox
TASKS_DIR=/srv/pullwright/tasks
SPEND_LEDGER_DIR=/srv/pullwright/spend
WORKER_CONCURRENCY=1
# SANDBOX_RUNTIME=runsc   # enable after installing gVisor (runsc install && systemctl restart docker)
