  {
   "id": "el0l2g3vunbyog",
   "type": "text",
   "x": 894,
   "y": 2728.5,
   "width": 565.5,
   "height": 93.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "elq1hl2kszpvqb"
   ],
   "frameId": "el9ns8bolb6r1x",
   "roundness": null,
   "seed": 897096561,
   "version": 1,
   "versionNonce": 1506472680,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2248100 T1 calls/day  (5 Flash models \u00d7 ~20)\n\u22481,000 T2 calls/day (2 Flash-Lite \u00d7 ~500)\nhard task \u2264 15 T1 calls (plan \u2264 8 \u00b7 review \u2264 3 \u00b7 escalations \u2264 4)\n\u2192 3 hard tasks/day fit with headroom (the free-plan limit)\nif Flash-Lite fails qualification \u2192 1\u20132 hard/day (meter shows it)",
   "originalText": "\u2248100 T1 calls/day  (5 Flash models \u00d7 ~20)\n\u22481,000 T2 calls/day (2 Flash-Lite \u00d7 ~500)\nhard task \u2264 15 T1 calls (plan \u2264 8 \u00b7 review \u2264 3 \u00b7 escalations \u2264 4)\n\u2192 3 hard tasks/day fit with headroom (the free-plan limit)\nif Flash-Lite fails qualification \u2192 1\u20132 hard/day (meter shows it)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
