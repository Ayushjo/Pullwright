{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "devin-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174"
      ],
      "cwd": "frontend",
      "port": 5174
    },
    {
      "name": "pullwright-backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "--env-file=.env",
        "src/index.ts"
      ],
      "cwd": "backend",
      "port": 3500
    },
    {
      "name": "pullwright-backend-free",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "--env-file=.env",
        "--env-file=lanes/free.env",
        "src/index.ts"
      ],
      "cwd": "backend",
      "port": 3500
    },
    {
      "name": "pullwright-backend-chaos",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "--env-file=.env",
        "--env-file=lanes/free.env",
        "--env-file=lanes/chaos-failover.env",
        "src/index.ts"
      ],
      "cwd": "backend",
      "port": 3500
    },
    {
      "name": "pullwright-backend-direct",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "--env-file=.env",
        "--env-file=lanes/direct.env",
        "src/index.ts"
      ],
      "cwd": "backend",
      "port": 3500
    }
  ]
}
